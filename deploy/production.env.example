# Install as /etc/okx-quant/production.env, owner root:okxquant-trader, mode 0640.
# Trader receives exchange credentials, but never backup encryption material.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_ACCOUNT_ID=
OKX_LIVE_CONFIRMED=1
OKX_QUANT_ALERT_WEBHOOK=
OKX_QUANT_APPROVED_MAX_SLIPPAGE=0.01
OKX_QUANT_APPROVED_MAX_STRESS_LOSS=100
