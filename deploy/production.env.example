# Install as /etc/okx-quant/production.env, owner root:okxquant-trader, mode 0640.
# Trader receives exchange credentials, but never backup encryption material.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_ACCOUNT_ID=
OKX_LIVE_CONFIRMED=1
OKX_HOST_IMAGE_SHA256=
OKX_IP_ALLOWLIST_SHA256=
OKX_QUANT_ALERT_WEBHOOK=
OKX_QUANT_APPROVED_MAX_SLIPPAGE=0.005
OKX_QUANT_APPROVED_MAX_STRESS_LOSS=100
OKX_QUANT_STAGE_C_RELEASE_FROZEN_AT=REPLACE_WITH_FINAL_FREEZE_ISO8601
OKX_QUANT_EMPTY_HOST_RESTORE_KEY_ID=REPLACE_WITH_EMPTY_HOST_RESTORE_KEY_ID
