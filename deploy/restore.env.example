# Install as /etc/okx-quant/restore.env, owner
# root:okxquant-restore-verifier, mode 0640.
# This identity can decrypt/read exact backup versions and sign restore
# evidence, but it cannot read the publisher's manifest private key.
OKX_QUANT_ACCOUNT_ID=
OKX_QUANT_BACKUP_PASSPHRASE=
OKX_QUANT_BACKUP_SIGNING_KEY_ID=backup-signing-2026q3
OKX_QUANT_BACKUP_ENCRYPTION_KEY_ID=backup-aes-2026q3
OKX_QUANT_BACKUP_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/REPLACE
OKX_QUANT_BACKUP_MANIFEST_PUBLIC_KEY=/etc/okx-quant/keys/backup-manifest-public.pem
OKX_QUANT_RESTORE_EVIDENCE_PRIVATE_KEY=/etc/okx-quant/keys/restore-verifier-private.pem
OKX_QUANT_RESTORE_EVIDENCE_PUBLIC_KEY=/etc/okx-quant/keys/restore-verifier-public.pem
OKX_QUANT_RESTORE_EVIDENCE_KEY_ID=restore-verifier-2026q3
