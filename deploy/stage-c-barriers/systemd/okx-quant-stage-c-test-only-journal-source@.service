[Unit]
Description=OKX Quant Stage-C TEST-ONLY PARSER_READY independent journal recovery source %i
Before=okx-quant-stage-c-test-only-driver@%i.service
OnSuccess=okx-quant-stage-c-test-only-recovery@%i.service
ConditionPathExists=/opt/okx-quant-stage-c-test-only/instrumented.pyz
ConditionFileIsExecutable=/opt/okx-quant-stage-c-test-only/venv/bin/python

[Service]
Type=simple
User=okxq-stagec-journal
Group=okxq-stagec-evidence
UMask=0027
StateDirectory=okx-quant-stage-c-test-only/source-journal/%i
StateDirectoryMode=0750
LoadCredential=scenario:/etc/okx-quant-stage-c-test-only/%i/scenario
LoadCredential=registrar-public-key:/etc/okx-quant-stage-c-test-only/%i/registrar-public.pem
LoadCredential=challenge-consumer-public-key:/etc/okx-quant-stage-c-test-only/%i/challenge-consumer-public.pem
LoadCredential=kill-public-key:/etc/okx-quant-stage-c-test-only/%i/kill-public.pem
LoadCredential=reached-public-key:/etc/okx-quant-stage-c-test-only/%i/attestor-public.pem
LoadCredential=okx-final-public-key:/etc/okx-quant-stage-c-test-only/%i/okx-source-public.pem
LoadCredential=source-private-key:/etc/okx-quant-stage-c-test-only/%i/journal-source-private.pem
ExecStart=/opt/okx-quant-stage-c-test-only/venv/bin/python /opt/okx-quant-stage-c-test-only/instrumented.pyz run-recovery-source \
  --scenario-file %d/scenario \
  --activation-request /run/okx-quant-stage-c-activation/%i/request.json \
  --registrar-public-key %d/registrar-public-key \
  --challenge-consumer-public-key %d/challenge-consumer-public-key \
  --kill-artifact /var/lib/okx-quant-stage-c-test-only/kill/%i/kill-attestation.json \
  --kill-public-key %d/kill-public-key \
  --reached-artifact /var/lib/okx-quant-stage-c-test-only/attestor/%i/reached-attestation.json \
  --reached-public-key %d/reached-public-key \
  --source journal_collector \
  --marker /var/lib/okx-quant-stage-c-test-only/hook/%i/reached.json \
  --proof /var/lib/okx-quant-stage-c-test-only/hook/%i/boundary-proof.json \
  --source-private-key %d/source-private-key \
  --database /var/lib/okx-quant-stage-c-test-only/runtime/%i/trading.db \
  --readiness-output /var/lib/okx-quant-stage-c-test-only/source-journal/%i/readiness.json \
  --okx-final-artifact /var/lib/okx-quant-stage-c-test-only/source-okx/%i/artifact.json \
  --okx-final-public-key %d/okx-final-public-key \
  --output /var/lib/okx-quant-stage-c-test-only/source-journal/%i/artifact.json
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/okx-quant-stage-c-test-only /run/okx-quant-stage-c-activation/%i /var/lib/okx-quant-stage-c-test-only/hook/%i /var/lib/okx-quant-stage-c-test-only/attestor/%i /var/lib/okx-quant-stage-c-test-only/kill/%i /var/lib/okx-quant-stage-c-test-only/runtime/%i /var/lib/okx-quant-stage-c-test-only/source-okx/%i
ReadWritePaths=/var/lib/okx-quant-stage-c-test-only/source-journal/%i
