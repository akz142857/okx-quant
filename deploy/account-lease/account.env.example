# Install on a separate failure-domain broker host as
# /etc/okx-quant-account-lease/active.env, root:okxquant-lease 0640.
# TOKEN_SHA256 is lowercase sha256(raw account-scoped bearer token).
OKX_QUANT_LEASE_ACCOUNT_UID=REPLACE_WITH_EXACT_OKX_ACCOUNT_UID
OKX_QUANT_LEASE_TOKEN_SHA256=REPLACE_64_HEX
OKX_QUANT_LEASE_BROKER_ID=demo-writer-lease-v1
OKX_QUANT_LEASE_LISTEN_HOST=0.0.0.0
OKX_QUANT_LEASE_LISTEN_PORT=9443
