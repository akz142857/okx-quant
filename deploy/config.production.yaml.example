okx:
  api_key: "${OKX_API_KEY}"
  secret_key: "${OKX_SECRET_KEY}"
  passphrase: "${OKX_PASSPHRASE}"
  simulated: false
  base_url: "https://openapi.okx.com"
  timeout: 15
  max_retries: 3

production:
  enabled: true
  environment: "production"
  # Canary 是 production 环境下的真实资金强制 tier，不是第三种 runtime environment。
  deployment_tier: "canary"
  # 必须填写 GET /api/v5/account/config 返回的不可变 uid。
  account_id: "${OKX_ACCOUNT_ID}"
  journal_path: "/var/lib/okx-quant/production/trading.db"
  lock_path: "/var/lib/okx-quant/production/trading.lock"
  backup_dir: "/var/lib/okx-quant/production/backups"
  heartbeat_path: "/var/lib/okx-quant/production/heartbeat"
  reconciliation_interval_s: 30
  max_clock_skew_s: 1
  ws_ready_timeout_s: 30
  backup_interval_s: 60
  backup_retention_days: 30
  alert_webhook_env: "OKX_QUANT_ALERT_WEBHOOK"
  # 运行时仅持有公钥；风险审批人的 Ed25519 私钥必须位于独立身份/设备。
  resume_approval_public_key: "/etc/okx-quant/keys/control-approval-public.pem"
  release_root: "/opt/okx-quant/current"
  launch_manifest_path: "/etc/okx-quant/launch.json"
  deployment_receipt_path: "/var/lib/okx-quant/admission/deployment-receipt.json"
  admission_evidence_path: "/etc/okx-quant/admission/evidence.json"
  admission_approval_path: "/etc/okx-quant/admission/approval.json"
  admission_approval_public_key: "/etc/okx-quant/keys/risk-approval-public.pem"
  # 异地加密由 okxquant-backup 独立身份负责；trader 只写本地在线快照。
  offsite_backup_uri: ""
  external_backup_managed: true
  # backup worker 写入签名 receipt；trader 只读、验签后自行落 journal。
  backup_receipt_path: "/var/lib/okx-quant-restore-evidence/daily/last-offsite-roundtrip.json"
  backup_receipt_public_key: "/etc/okx-quant/keys/restore-verifier-public.pem"
  # 必须与 restore.env 的 OKX_QUANT_RESTORE_EVIDENCE_KEY_ID 完全一致。
  backup_receipt_key_id: "restore-verifier-2026q3"
  metrics_host: "127.0.0.1"
  metrics_port: 9108
  shadow_mode: false
  allowed_instruments: ["BTC-USDT"]
  canary_transition_path: "/etc/okx-quant/canary/transition.json"
  canary_policy_path: "/etc/okx-quant/canary/policy.json"
  # 由 safety-kernel 启动后的外部核验器双签，短效且绑定 boot/runtime。
  canary_activation_path: "/etc/okx-quant/canary/post-start-activation.json"
  canary_operator_public_key: "/etc/okx-quant/keys/canary-operator-public.pem"
  canary_risk_public_key: "/etc/okx-quant/keys/canary-risk-public.pem"
  canary_check_verifier_public_key: "/etc/okx-quant/keys/canary-check-verifier-public.pem"
  host_image_sha256: "${OKX_HOST_IMAGE_SHA256}"
  ip_allowlist_sha256: "${OKX_IP_ALLOWLIST_SHA256}"
  api_permissions: ["read", "trade"]
  deployment_unit: "okx-quant.service"
  max_order_loss_usdt: 2
  max_position_notional_usdt: 25
  max_total_exposure_usdt: 50
  max_open_positions: 1
  max_daily_loss_usdt: 5
  max_drawdown_ratio: 0.02
  max_order_intents_per_hour: 6
  max_spread_ratio: 0.003
  max_slippage_ratio: 0.005
  max_candle_range_ratio: 0.15
  min_24h_quote_volume_usdt: 500000
  max_market_data_age_s: 5
  max_account_snapshot_age_s: 90
  max_unprotected_position_s: 10
  max_consecutive_infrastructure_errors: 3
  resource_sample_interval_s: 60
  memory_high_bytes: 524288000
  memory_max_bytes: 629145600
  limit_nofile: 4096
  tasks_max: 128
  max_database_bytes: 2147483648
  max_wal_bytes: 268435456
  max_wal_checkpoint_age_s: 300
  max_database_growth_bytes_per_day: 268435456
  resource_min_free_bytes: 5368709120
  resource_min_free_inodes: 10000

risk:
  max_position_pct: 0.1
  max_drawdown_pct: 0.05
  drawdown_recover_ratio: 0
  stop_loss_pct: 0.02
  take_profit_pct: 0.04
  max_open_positions: 2
  min_order_usdt: 5

logging:
  level: "INFO"
  file: "/var/log/okx-quant/quant.log"

executor:
  signal_timeout_s: 20
  state_dir: "/var/lib/okx-quant/production/legacy-state"

backtest:
  initial_capital: 10000
  fee_rate: 0.001
  slippage: 0.0005

strategies: {}
