# Install only on an independent monitor host as /etc/okx-quant-external-monitor/demo-shadow.env.
OKX_QUANT_EXTERNAL_HEALTH_URL=https://REPLACE-EXTERNAL-GATEWAY/demo-shadow/healthz
OKX_QUANT_EXTERNAL_READY_URL=https://REPLACE-EXTERNAL-GATEWAY/demo-shadow/readyz
OKX_QUANT_HOST_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-shadow/host
OKX_QUANT_SERVICE_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-shadow/service
OKX_QUANT_PROVIDER_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-shadow/provider
OKX_QUANT_EVIDENCE_CLOSE_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-shadow/evidence-close
OKX_QUANT_BACKUP_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-shadow/backup
OKX_QUANT_EXPECTED_RELEASE=REPLACE_40_HEX_COMMIT
OKX_QUANT_EXPECTED_CONFIG=REPLACE_64_HEX_CONFIG_HASH
OKX_QUANT_EXPECTED_ACCOUNT_UID=REPLACE_WITH_SHADOW_ACCOUNT_UID
OKX_QUANT_EXPECTED_UNIT=okx-quant-demo-shadow.service
OKX_QUANT_SOAK_EPOCH_ID=shadow-prewarm
OKX_QUANT_EXTERNAL_MONITOR_PRIVATE_KEY=/etc/okx-quant-external-monitor/keys/monitor-private.pem
OKX_QUANT_EXTERNAL_MONITOR_KEY_ID=external-monitor-v1
OKX_QUANT_PRIMARY_PAGE_URL=https://REPLACE-PROVIDER-A
OKX_QUANT_INDEPENDENT_PAGE_URL=https://REPLACE-PROVIDER-B
