# Install only on an independent monitor host as /etc/okx-quant-external-monitor/demo-chaos.env.
OKX_QUANT_EXTERNAL_HEALTH_URL=https://REPLACE-EXTERNAL-GATEWAY/demo-chaos/healthz
OKX_QUANT_EXTERNAL_READY_URL=https://REPLACE-EXTERNAL-GATEWAY/demo-chaos/readyz
OKX_QUANT_HOST_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-chaos/host
OKX_QUANT_SERVICE_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-chaos/service
OKX_QUANT_PROVIDER_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-chaos/provider
OKX_QUANT_EVIDENCE_CLOSE_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-chaos/evidence-close
OKX_QUANT_BACKUP_SIGNAL_URL=https://REPLACE-INDEPENDENT-SIGNAL-GATEWAY/demo-chaos/backup
OKX_QUANT_EXPECTED_RELEASE=REPLACE_40_HEX_COMMIT
OKX_QUANT_EXPECTED_CONFIG=REPLACE_64_HEX_CONFIG_HASH
OKX_QUANT_EXPECTED_ACCOUNT_UID=REPLACE_WITH_CHAOS_ACCOUNT_UID
OKX_QUANT_EXPECTED_UNIT=okx-quant-demo-chaos.service
OKX_QUANT_SOAK_EPOCH_ID=chaos-not-counted
OKX_QUANT_EXTERNAL_MONITOR_PRIVATE_KEY=/etc/okx-quant-external-monitor/keys/monitor-private.pem
OKX_QUANT_EXTERNAL_MONITOR_KEY_ID=external-monitor-v1
OKX_QUANT_PRIMARY_PAGE_URL=https://REPLACE-PROVIDER-A
OKX_QUANT_INDEPENDENT_PAGE_URL=https://REPLACE-PROVIDER-B
