# Install as /etc/okx-quant/backup.env, owner root:okxquant-backup, mode 0640.
# The backup worker must not inherit OKX Read/Trade credentials.
OKX_QUANT_ACCOUNT_ID=
OKX_QUANT_OFFSITE_BACKUP_URI=s3://replace-me/okx-quant/
OKX_QUANT_BACKUP_PASSPHRASE=
OKX_QUANT_BACKUP_SIGNING_KEY_ID=backup-signing-2026q3
OKX_QUANT_BACKUP_ENCRYPTION_KEY_ID=backup-aes-2026q3
OKX_QUANT_BACKUP_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/REPLACE
OKX_QUANT_ALERT_WEBHOOK=https://replace-me.example/critical-page
