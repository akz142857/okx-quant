/var/log/okx-quant/demo-shadow/*.log {
    daily
    rotate 35
    compress
    delaycompress
    missingok
    notifempty
    su okxquant-demo-shadow okxquant-data-shadow
    create 0640 okxquant-demo-shadow okxquant-data-shadow
}

