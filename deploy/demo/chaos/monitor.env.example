# Install as /etc/okx-quant/demo-chaos-monitor.env, root:root 0600.
OKX_QUANT_ACCOUNT_ID=REPLACE_WITH_CHAOS_ACCOUNT_UID
OKX_QUANT_SOAK_EPOCH=REPLACE_WITH_SIGNED_EPOCH_PATH
OKX_QUANT_SOAK_PHASE=chaos
OKX_QUANT_EVIDENCE_OUTPUT_DIR=/var/lib/okx-quant-evidence/demo-chaos
OKX_QUANT_MONITOR_PRIVATE_KEY=/etc/okx-quant/keys/chaos-monitor-private.pem
OKX_QUANT_MONITOR_PUBLIC_KEY=/etc/okx-quant/keys/chaos-monitor-public.pem
OKX_QUANT_MONITOR_KEY_ID=demo-chaos-monitor-v1
OKX_QUANT_EPOCH_MONITOR_PUBLIC_KEY=/etc/okx-quant/keys/epoch-monitor-public.pem
OKX_QUANT_EPOCH_RISK_PUBLIC_KEY=/etc/okx-quant/keys/epoch-risk-public.pem
OKX_QUANT_EVIDENCE_OFFSITE_URI=s3://REPLACE/demo-chaos-evidence
OKX_QUANT_EVIDENCE_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/REPLACE
OKX_QUANT_MAX_SLIPPAGE_RATIO=0.005
OKX_QUANT_EXTERNAL_MONITOR_WEBHOOK=https://REPLACE-INDEPENDENT-PROVIDER
