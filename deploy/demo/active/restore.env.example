# Install as /etc/okx-quant/demo-active-restore.env,
# root:okxquant-restore-active 0640.
OKX_QUANT_BACKUP_OUTPUT_DIR=/var/lib/okx-quant-backup/demo-active
OKX_QUANT_ACCOUNT_ID=REPLACE_WITH_ACTIVE_ACCOUNT_UID
OKX_QUANT_BACKUP_PASSPHRASE=REPLACE_WITH_INDEPENDENT_BACKUP_SECRET
OKX_QUANT_BACKUP_SIGNING_KEY_ID=demo-active-backup-v1
OKX_QUANT_BACKUP_ENCRYPTION_KEY_ID=REPLACE_WITH_KMS_KEY_ID
OKX_QUANT_BACKUP_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/REPLACE
OKX_QUANT_BACKUP_MANIFEST_PUBLIC_KEY=/etc/okx-quant/keys/active-backup-public.pem
OKX_QUANT_RESTORE_EVIDENCE_PRIVATE_KEY=/etc/okx-quant/keys/active-restore-private.pem
OKX_QUANT_RESTORE_EVIDENCE_PUBLIC_KEY=/etc/okx-quant/keys/active-restore-public.pem
OKX_QUANT_RESTORE_EVIDENCE_KEY_ID=demo-active-restore-v1
