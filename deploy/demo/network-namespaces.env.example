# Root-only input for scripts/setup_demo_namespaces.sh.
# Each namespace gets a distinct /30; the host uplink is only used for SNAT.
OKX_QUANT_UPLINK_INTERFACE=eth0
OKX_QUANT_SHADOW_HOST_CIDR=10.203.0.1/30
OKX_QUANT_SHADOW_GUEST_CIDR=10.203.0.2/30
OKX_QUANT_ACTIVE_HOST_CIDR=10.203.0.5/30
OKX_QUANT_ACTIVE_GUEST_CIDR=10.203.0.6/30
OKX_QUANT_CHAOS_HOST_CIDR=10.203.0.9/30
OKX_QUANT_CHAOS_GUEST_CIDR=10.203.0.10/30
OKX_QUANT_DNS_SERVER=1.1.1.1
