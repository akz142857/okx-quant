[Unit]
Description=OKX Quant isolated Demo Active
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=okx-quant-demo-monitor-failure@active.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=okx-quant-demo-watchdog@active.service okx-quant-demo-backup@active.timer okx-quant-demo-offsite-restore@active.timer
After=okx-quant-demo-watchdog@active.service
RequiresMountsFor=/var/lib/okx-quant-backup/demo-active

[Service]
Type=notify
NotifyAccess=main
User=okxquant-demo-active
Group=okxquant-data-active
WorkingDirectory=/opt/okx-quant/demo-active/current
EnvironmentFile=/etc/okx-quant/demo-active.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okx-quant-demo-active
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NetworkNamespacePath=/run/netns/okx-quant-demo-active
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /run/okx-quant-demo-preflight
ExecStartPre=+/usr/bin/install -d -o root -g okxquant-data-active -m 0750 /run/okx-quant-demo-preflight/active
ExecStartPre=+/opt/okx-quant/demo-active/current/.venv/bin/python /opt/okx-quant/demo-active/current/scripts/demo_preflight.py issue --config /etc/okx-quant/demo-active.yaml --receipt /run/okx-quant-demo-preflight/active/receipt.json --peer-config /etc/okx-quant/demo-shadow.yaml --peer-config /etc/okx-quant/demo-chaos.yaml
ExecStartPre=+/opt/okx-quant/demo-active/current/.venv/bin/python /opt/okx-quant/demo-active/current/scripts/demo_preflight.py verify --config /etc/okx-quant/demo-active.yaml --receipt /run/okx-quant-demo-preflight/active/receipt.json
ExecStart=/opt/okx-quant/demo-active/current/.venv/bin/python /opt/okx-quant/demo-active/current/main.py --config /etc/okx-quant/demo-active.yaml live --inst BTC-USDT --strategy validation_probe --bar 1H --interval 60 --no-dashboard --yes
ExecStartPost=/opt/okx-quant/demo-active/current/.venv/bin/python /opt/okx-quant/demo-active/current/scripts/wait_ready.py --url http://127.0.0.1:9209/readyz --timeout 60
Restart=on-failure
RestartSec=5
WatchdogSec=20
TimeoutStartSec=180
TimeoutStopSec=30
UMask=0027
StateDirectory=okx-quant/demo-active
StateDirectoryMode=2750
LogsDirectory=okx-quant/demo-active
LogsDirectoryMode=0750
MemoryHigh=500M
MemoryMax=600M
CPUQuota=80%
CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true
LimitNOFILE=4096
TasksMax=128
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/okx-quant/demo-active /var/log/okx-quant/demo-active
ReadOnlyPaths=/etc/okx-quant /var/lib/okx-quant-restore-evidence/demo-active
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
