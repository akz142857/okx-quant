[Unit]
Description=OKX Quant isolated encrypted offsite backup
After=okx-quant.service
OnFailure=okx-quant-backup-failure@%n.service

[Service]
Type=oneshot
User=okxquant-backup
Group=okxquant-data
EnvironmentFile=/etc/okx-quant/backup.env
ExecStart=/opt/okx-quant/venv/bin/python /opt/okx-quant/current/scripts/daily_archive.py --database /var/lib/okx-quant/production/trading.db --output-dir /var/lib/okx-quant-backup/daily --offsite-uri ${OKX_QUANT_OFFSITE_BACKUP_URI} --kms-key-id ${OKX_QUANT_BACKUP_KMS_KEY_ID} --object-lock-retention-days 35 --expected-account-id ${OKX_QUANT_ACCOUNT_ID} --manifest-private-key /etc/okx-quant/keys/backup-manifest-private.pem --manifest-public-key /etc/okx-quant/keys/backup-manifest-public.pem --signing-key-id ${OKX_QUANT_BACKUP_SIGNING_KEY_ID} --encryption-key-id ${OKX_QUANT_BACKUP_ENCRYPTION_KEY_ID} --min-free-bytes 5368709120
TimeoutStartSec=300
UMask=0027
StateDirectory=okx-quant-backup/daily
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/okx-quant/production
ReadWritePaths=/var/lib/okx-quant-backup/daily
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
