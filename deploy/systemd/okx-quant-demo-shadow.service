[Unit]
Description=OKX Quant isolated Demo Shadow (read-only)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=okx-quant-demo-monitor-failure@shadow.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=okx-quant-demo-watchdog@shadow.service okx-quant-demo-backup@shadow.timer okx-quant-demo-offsite-restore@shadow.timer
After=okx-quant-demo-watchdog@shadow.service
RequiresMountsFor=/var/lib/okx-quant-backup/demo-shadow

[Service]
Type=notify
NotifyAccess=main
User=okxquant-demo-shadow
Group=okxquant-data-shadow
WorkingDirectory=/opt/okx-quant/demo-shadow/current
EnvironmentFile=/etc/okx-quant/demo-shadow.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okx-quant-demo-shadow
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NetworkNamespacePath=/run/netns/okx-quant-demo-shadow
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /run/okx-quant-demo-preflight
ExecStartPre=+/usr/bin/install -d -o root -g okxquant-data-shadow -m 0750 /run/okx-quant-demo-preflight/shadow
ExecStartPre=+/opt/okx-quant/demo-shadow/current/.venv/bin/python /opt/okx-quant/demo-shadow/current/scripts/demo_preflight.py issue --config /etc/okx-quant/demo-shadow.yaml --receipt /run/okx-quant-demo-preflight/shadow/receipt.json --peer-config /etc/okx-quant/demo-active.yaml --peer-config /etc/okx-quant/demo-chaos.yaml
ExecStartPre=+/opt/okx-quant/demo-shadow/current/.venv/bin/python /opt/okx-quant/demo-shadow/current/scripts/demo_preflight.py verify --config /etc/okx-quant/demo-shadow.yaml --receipt /run/okx-quant-demo-preflight/shadow/receipt.json
ExecStart=/opt/okx-quant/demo-shadow/current/.venv/bin/python /opt/okx-quant/demo-shadow/current/main.py --config /etc/okx-quant/demo-shadow.yaml live --inst BTC-USDT --strategy ma_cross --bar 1H --interval 60 --no-dashboard --yes
ExecStartPost=/opt/okx-quant/demo-shadow/current/.venv/bin/python /opt/okx-quant/demo-shadow/current/scripts/wait_ready.py --url http://127.0.0.1:9208/readyz --timeout 60
Restart=on-failure
RestartSec=5
WatchdogSec=20
TimeoutStartSec=180
TimeoutStopSec=30
UMask=0027
StateDirectory=okx-quant/demo-shadow
StateDirectoryMode=2750
LogsDirectory=okx-quant/demo-shadow
LogsDirectoryMode=0750
MemoryHigh=500M
MemoryMax=600M
CPUQuota=80%
CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true
LimitNOFILE=4096
TasksMax=128
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/okx-quant/demo-shadow /var/log/okx-quant/demo-shadow
ReadOnlyPaths=/etc/okx-quant /var/lib/okx-quant-restore-evidence/demo-shadow
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
