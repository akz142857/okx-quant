[Unit]
Description=OKX Quant isolated Demo Chaos
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=okx-quant-demo-monitor-failure@chaos.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=okx-quant-demo-watchdog@chaos.service okx-quant-demo-backup@chaos.timer okx-quant-demo-offsite-restore@chaos.timer
Requires=okx-quant-demo-ws-proxy@public.service okx-quant-demo-ws-proxy@private.service okx-quant-demo-ws-proxy@business.service
After=okx-quant-demo-watchdog@chaos.service okx-quant-demo-ws-proxy@public.service okx-quant-demo-ws-proxy@private.service okx-quant-demo-ws-proxy@business.service
RequiresMountsFor=/var/lib/okx-quant-backup/demo-chaos

[Service]
Type=notify
NotifyAccess=main
User=okxquant-demo-chaos
Group=okxquant-data-chaos
WorkingDirectory=/opt/okx-quant/demo-chaos/current
EnvironmentFile=/etc/okx-quant/demo-chaos.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okx-quant-demo-chaos
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NetworkNamespacePath=/run/netns/okx-quant-demo-chaos
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /run/okx-quant-demo-preflight
ExecStartPre=+/usr/bin/install -d -o root -g okxquant-data-chaos -m 0750 /run/okx-quant-demo-preflight/chaos
ExecStartPre=+/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/scripts/demo_preflight.py issue --config /etc/okx-quant/demo-chaos.yaml --receipt /run/okx-quant-demo-preflight/chaos/receipt.json --peer-config /etc/okx-quant/demo-shadow.yaml --peer-config /etc/okx-quant/demo-active.yaml
ExecStartPre=+/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/scripts/demo_preflight.py verify --config /etc/okx-quant/demo-chaos.yaml --receipt /run/okx-quant-demo-preflight/chaos/receipt.json
ExecStart=/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/main.py --config /etc/okx-quant/demo-chaos.yaml live --inst BTC-USDT --strategy ma_cross --bar 1H --interval 60 --no-dashboard --yes
ExecStartPost=/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/scripts/wait_ready.py --url http://127.0.0.1:9210/readyz --timeout 60
Restart=on-failure
RestartSec=5
WatchdogSec=20
TimeoutStartSec=180
TimeoutStopSec=30
UMask=0027
StateDirectory=okx-quant/demo-chaos
StateDirectoryMode=2750
LogsDirectory=okx-quant/demo-chaos
LogsDirectoryMode=0750
MemoryHigh=500M
MemoryMax=600M
CPUQuota=80%
CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true
LimitNOFILE=4096
TasksMax=128
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/okx-quant/demo-chaos /var/log/okx-quant/demo-chaos
ReadOnlyPaths=/etc/okx-quant /var/lib/okx-quant-restore-evidence/demo-chaos
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
