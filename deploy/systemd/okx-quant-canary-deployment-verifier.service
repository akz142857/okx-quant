[Unit]
Description=OKX Quant stage-2 independent Canary deployment verifier

[Service]
Type=oneshot
RemainAfterExit=yes
User=oqc-deploy-verify
Group=oqc-capability-readers
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/etc/okx-quant
ReadOnlyPaths=/opt/okx-quant/current
ReadOnlyPaths=/var/lib/okx-quant-canary-sources/raw
ReadOnlyPaths=/var/lib/okx-quant-canary-sources/signed
ReadWritePaths=/var/lib/okx-quant-canary-sources/deployment-verifier
LoadCredential=deployment-verifier-private-key:/etc/okx-quant/keys/canary-deployment-verifier-private.pem
ExecStart=/usr/local/libexec/okx-quant-canary-deployment-verifier \
  --transition /etc/okx-quant/canary-producers/transition.json \
  --operator-public-key /etc/okx-quant/keys/canary-operator-public.pem \
  --risk-public-key /etc/okx-quant/keys/canary-risk-public.pem \
  --host-image-sha256 /etc/okx-quant/host-image.sha256 \
  --collector-executable /usr/local/libexec/okx-quant-canary-source-collector \
  --signer-executable /usr/local/libexec/okx-quant-canary-source-signer \
  --parser /opt/okx-quant/current/okx_quant/research/canary.py \
  --private-key %d/deployment-verifier-private-key \
  --output /var/lib/okx-quant-canary-sources/deployment-verifier/receipt.json
