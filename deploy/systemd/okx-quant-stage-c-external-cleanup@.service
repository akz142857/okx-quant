[Unit]
Description=OKX Quant Stage-C challenge-bound external Demo cleanup %i
After=okx-quant-stage-c-external-systemd-source@%i.service

[Service]
Type=oneshot
User=okxquant-stagec-actor
Group=okxquant-stagec-raw-readers
SupplementaryGroups=okxquant-data-chaos
UMask=0077
RuntimeDirectory=okx-quant-stage-c-external-cleanup-%i
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/okx-quant/demo-chaos/current
ExecStart=/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/scripts/stage_c_external_scenario.py cleanup --report /var/lib/okx-quant-stage-c/external/actor/%i/actor-report.json --challenge /var/lib/okx-quant-stage-c/challenges/%i.json --registrar-public-key /etc/okx-quant/stage-c/keys/registrar-public.pem --consumption-receipt /var/lib/okx-quant-stage-c/consumption/%i.json --consumer-public-key /etc/okx-quant/stage-c/keys/challenge-consumer-public.pem --config /etc/okx-quant/stage-c/external-actor.yaml --journal /var/lib/okx-quant/demo-chaos/trading.db --confirm I_UNDERSTAND_STAGE_C_DEMO_TRADES --authorization-wait-seconds 360 --required-collection /var/lib/okx-quant-stage-c/external/raw-systemd/%i/systemd-source-raw.json --output /var/lib/okx-quant-stage-c/external/actor/%i/cleanup-report.json
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/opt/okx-quant/demo-chaos/current
ReadOnlyPaths=/etc/okx-quant /var/lib/okx-quant-stage-c/challenges /var/lib/okx-quant-stage-c/consumption
ReadWritePaths=/var/lib/okx-quant-stage-c/external/actor/%i /var/lib/okx-quant/demo-chaos
CapabilityBoundingSet=
AmbientCapabilities=
TimeoutStartSec=420
