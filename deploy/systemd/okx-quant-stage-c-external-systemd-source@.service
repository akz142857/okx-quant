[Unit]
Description=OKX Quant Stage-C independent systemd raw acquirer %i
Before=okx-quant-stage-c-external-cleanup@%i.service
OnFailure=okx-quant-stage-c-external-cleanup@%i.service

[Service]
Type=oneshot
User=okxquant-stagec-systemd-source
Group=okxquant-stagec-raw-readers
UMask=0027
StateDirectory=okx-quant-stage-c/external/raw-systemd/%i
StateDirectoryMode=0750
WorkingDirectory=/opt/okx-quant/demo-chaos/current
LoadCredential=acquirer-private-key.pem:/etc/okx-quant/stage-c/keys/systemd-acquirer-private.pem
ExecStart=/opt/okx-quant/demo-chaos/current/.venv/bin/python /opt/okx-quant/demo-chaos/current/scripts/stage_c_external_control_source.py --role systemd_collector --challenge /var/lib/okx-quant-stage-c/challenges/%i.json --registrar-public-key /etc/okx-quant/stage-c/keys/registrar-public.pem --acquirer-private-key %d/acquirer-private-key.pem --capability-attestation /var/lib/okx-quant-stage-c/capabilities/%i.json --driver-ready-output /var/lib/okx-quant-stage-c/external/raw-systemd/%i/driver-ready.json --wait-for /var/lib/okx-quant-stage-c/external/raw-clock/%i/clock-source-raw.json --wait-for /var/lib/okx-quant-stage-c/external/raw-provider/%i/provider-source-raw.json --wait-for /var/lib/okx-quant-stage-c/external/raw-okx/%i/okx-source-raw.json --wait-for /var/lib/okx-quant-stage-c/external/raw-journal/%i/journal-source-raw.json --wait-seconds 360 --output /var/lib/okx-quant-stage-c/external/raw-systemd/%i/systemd-source-raw.json
ExecStartPost=/usr/bin/chmod 0640 /var/lib/okx-quant-stage-c/external/raw-systemd/%i/driver-ready.json /var/lib/okx-quant-stage-c/external/raw-systemd/%i/systemd-source-raw.json
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/etc/okx-quant /opt/okx-quant/demo-chaos/current /var/lib/okx-quant-stage-c/challenges /var/lib/okx-quant-stage-c/capabilities /var/lib/okx-quant-stage-c/external
ReadWritePaths=/var/lib/okx-quant-stage-c/external/raw-systemd/%i
CapabilityBoundingSet=
AmbientCapabilities=
TimeoutStartSec=420

[Install]
WantedBy=multi-user.target
